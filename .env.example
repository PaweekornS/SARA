DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname
OPENROUTER_API_KEY=your_openrouter_api_key_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
