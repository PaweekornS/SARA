DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# AI4Thai / Pathumma API Config
APP_AI4THAI_API_KEY=your_ai4thai_api_key_here
PATHUMMA_MODEL_NAME=thaillm-8b
ASR_URL=https://tokenmind.pathumma.in.th
ASR_MODEL=ptm-asr-1

# ── Frontend (SARA v2) ────────────────────────────────────────────────
# ตอนนี้ frontend เดินบน mock data เพราะ backend v2 ยังไม่มี
# เมื่อ API v2 ตาม §6 ของ SARA_v2_Requirements.md พร้อมแล้ว ให้ตั้ง USE_MOCK=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_USE_MOCK=true

# ── Backend v2 เพิ่มเติม ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
MCP_SERVER_URL=http://localhost:8001/mcp
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=500

# ลายเซ็นของ magic link ที่ให้ผู้รับผิดชอบแจ้งสถานะกลับโดยไม่ต้องล็อกอิน
# ต้องเปลี่ยนก่อนใช้งานจริง ไม่งั้นใครก็ปลอมลิงก์ได้
SECRET_KEY=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8000

# เตือนมติล่วงหน้ากี่วัน และเว้นระยะไม่ให้เตือนซ้ำถี่เกินไป
REMINDER_LEAD_DAYS=7
REMINDER_COOLDOWN_DAYS=7

# ไฟล์ .docx ต้นแบบขององค์กร (ถ้าเว้นว่างระบบจะสร้างเอกสารตามระเบียบสารบรรณให้เอง)
AGENDA_TEMPLATE_PATH=
MINUTES_TEMPLATE_PATH=
