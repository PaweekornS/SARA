FROM node:20-alpine

WORKDIR /app

# dependency ก่อนโค้ด เพื่อให้ build ซ้ำใช้ cache ได้
COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

# ค่าพวกนี้ถูกฝังตอน build จึงต้องรับเป็น build arg
#   API_PROXY_TARGET  ปลายทางของ rewrite /api (ใช้ตอนไม่มี reverse proxy ข้างหน้า เช่นรันบนเครื่องตัวเอง)
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID  ปุ่ม Google Sign-In บนหน้า login
ARG API_PROXY_TARGET=http://api:8000
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ENV API_PROXY_TARGET=$API_PROXY_TARGET
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
