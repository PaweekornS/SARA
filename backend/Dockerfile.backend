FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 \
    EMBEDDING_CACHE_DIR=/opt/models

WORKDIR /app

# ffmpeg ใช้แบ่ง/แปลงไฟล์เสียงก่อนส่ง ASR · curl ใช้ใน healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

# dependency ก่อนโค้ด เพื่อให้ build ซ้ำใช้ cache ได้ (job deploy มีเวลา 20 นาที)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ฝังโมเดล embedding ไว้ใน image — container จะได้ไม่ต้องโหลด ~220 MB ทุกครั้งที่เริ่ม
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('${EMBEDDING_MODEL}', cache_dir='${EMBEDDING_CACHE_DIR}')"

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
